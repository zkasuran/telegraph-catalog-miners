{
  "basis": "Official current YAML documentation T4, local projection",
  "backend_schema_verified": false,
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "version",
      "kind",
      "id",
      "slug",
      "name",
      "base_url"
    ],
    "properties": {
      "version": {
        "const": "1"
      },
      "kind": {
        "const": "miner"
      },
      "id": {
        "type": "integer"
      },
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "protocol": {},
      "name": {},
      "description": {},
      "base_url": {
        "type": "string",
        "pattern": "^https://"
      },
      "input_schema": {},
      "output_schema": {},
      "intent_mapping": {},
      "polling": {},
      "cache_ttl_sec": {},
      "rate_limit_per_sec": {},
      "circuit_threshold": {},
      "circuit_cooldown_seconds": {},
      "docs": {},
      "limitations": {},
      "errors": {},
      "auth": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "none"
          }
        },
        "required": [
          "type"
        ]
      },
      "endpoints": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {},
            "external_path": {},
            "method": {},
            "description": {},
            "intents": {},
            "params": {},
            "endpoint_base_url": {},
            "content_type": {},
            "multipart_fields": {},
            "param_map": {}
          },
          "required": [
            "path",
            "external_path",
            "method",
            "description",
            "intents"
          ]
        }
      },
      "semantics": {},
      "on_chain": {}
    }
  }
}
