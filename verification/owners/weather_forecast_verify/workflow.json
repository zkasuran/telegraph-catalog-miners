{
  "concurrency": {
    "cancel-in-progress": false,
    "group": "weather-owner-${{ inputs.mode }}"
  },
  "env": {
    "MKL_NUM_THREADS": "4",
    "OMP_NUM_THREADS": "4",
    "PYTHONDONTWRITEBYTECODE": "1",
    "TOKENIZERS_PARALLELISM": "false"
  },
  "jobs": {
    "audit": {
      "if": "${{ inputs.mode == 'experiment' && !inputs.development_only }}",
      "needs": "train",
      "runs-on": "ubuntu-24.04",
      "steps": [
        {
          "uses": "actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803",
          "with": {
            "persist-credentials": false
          }
        },
        {
          "uses": "actions/setup-go@924ae3a1cded613372ab5595356fb5720e22ba16",
          "with": {
            "cache": false,
            "go-version": "1.25.7"
          }
        },
        {
          "uses": "actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093",
          "with": {
            "name": "weather-frozen-candidate",
            "path": "${{ runner.temp }}/weather-result"
          }
        },
        {
          "name": "Hash-locked CPU tokenizer dependencies",
          "run": "python3 -m venv \"$RUNNER_TEMP/weather-venv\" && \"$RUNNER_TEMP/weather-venv/bin/python\" -m pip install --require-hashes --only-binary=:all: --index-url https://pypi.org/simple --extra-index-url https://download.pytorch.org/whl/cpu -r verification/owners/weather_forecast_verify/requirements.lock && \"$RUNNER_TEMP/weather-venv/bin/python\" -m pip check",
          "timeout-minutes": 15
        },
        {
          "name": "One-shot actual reference-engine audit",
          "run": "timeout --signal=TERM --kill-after=20s 5300 \"$RUNNER_TEMP/weather-venv/bin/python\" verification/owners/weather_forecast_verify/audit_remote.py --root \"$RUNNER_TEMP/weather-result\"",
          "timeout-minutes": 90
        },
        {
          "if": "always()",
          "name": "Only actual audit and runtime evidence",
          "uses": "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02",
          "with": {
            "if-no-files-found": "warn",
            "name": "weather-independent-audit",
            "path": "${{ runner.temp }}/weather-result/*.json\n${{ runner.temp }}/weather-result/*-runtime.log",
            "retention-days": 7
          }
        }
      ],
      "timeout-minutes": 110
    },
    "serve": {
      "env": {
        "FORWARD_PORT": "${{ inputs.forward_port }}",
        "PACKAGE_URL": "${{ inputs.package_url }}",
        "REPORT_SHA256": "${{ inputs.report_sha256 }}",
        "REPORT_URL": "${{ inputs.report_url }}",
        "RUNNABLE_URL": "${{ inputs.runnable_url }}",
        "SLOT": "${{ inputs.slot }}"
      },
      "if": "${{ inputs.mode == 'serve' }}",
      "runs-on": "ubuntu-24.04",
      "steps": [
        {
          "uses": "actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803",
          "with": {
            "persist-credentials": false
          }
        },
        {
          "uses": "actions/setup-go@924ae3a1cded613372ab5595356fb5720e22ba16",
          "with": {
            "cache": false,
            "go-version": "1.25.7"
          }
        },
        {
          "name": "Prepare live identical executor and its public restricted lease",
          "run": "mkdir -p \"$RUNNER_TEMP/weather-serving\"; python3 verification/owners/weather_forecast_verify/serving.py --root \"$RUNNER_TEMP/weather-serving\" --package-url \"$PACKAGE_URL\" --report-url \"$REPORT_URL\" --report-sha256 \"$REPORT_SHA256\" --slot \"$SLOT\" --forward-port \"$FORWARD_PORT\" --runnable-url \"$RUNNABLE_URL\" >\"$RUNNER_TEMP/weather-serving/serving.log\" 2>&1 & pid=$!; printf '%s\\n' \"$pid\" >\"$RUNNER_TEMP/weather-serving/process.pid\"; deadline=$((SECONDS+1400)); while [ ! -f \"$RUNNER_TEMP/weather-serving/lease.json\" ]; do kill -0 \"$pid\" || exit 1; [ \"$SECONDS\" -lt \"$deadline\" ] || exit 1; sleep 2; done",
          "timeout-minutes": 25
        },
        {
          "name": "Upload only restricted public lease while the executor is alive",
          "uses": "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02",
          "with": {
            "if-no-files-found": "error",
            "name": "weather-serving-public-lease",
            "path": "${{ runner.temp }}/weather-serving/lease.json",
            "retention-days": 1
          }
        },
        {
          "name": "Keep the exact serving run active for the bounded lease",
          "run": "python3 verification/owners/weather_forecast_verify/serving_monitor.py --root \"$RUNNER_TEMP/weather-serving\"",
          "timeout-minutes": 302
        }
      ],
      "timeout-minutes": 330
    },
    "train": {
      "if": "${{ inputs.mode == 'experiment' }}",
      "runs-on": "ubuntu-24.04",
      "steps": [
        {
          "uses": "actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803",
          "with": {
            "persist-credentials": false
          }
        },
        {
          "uses": "actions/setup-go@924ae3a1cded613372ab5595356fb5720e22ba16",
          "with": {
            "cache": false,
            "go-version": "1.25.7"
          }
        },
        {
          "name": "Same source-only release gate",
          "run": "bash verification/owners/weather_forecast_verify/verify.sh && python3 verification/owners/weather_forecast_verify/live_class.py",
          "timeout-minutes": 4
        },
        {
          "name": "Hash-locked CPU dependencies",
          "run": "python3 -m venv \"$RUNNER_TEMP/weather-venv\" && \"$RUNNER_TEMP/weather-venv/bin/python\" -m pip install --require-hashes --only-binary=:all: --index-url https://pypi.org/simple --extra-index-url https://download.pytorch.org/whl/cpu -r verification/owners/weather_forecast_verify/requirements.lock && \"$RUNNER_TEMP/weather-venv/bin/python\" -m pip check && \"$RUNNER_TEMP/weather-venv/bin/python\" verification/owners/weather_forecast_verify/dependency-audit.py --lock verification/owners/weather_forecast_verify/requirements.lock --out \"$RUNNER_TEMP/weather-dependencies.txt\" --report \"$RUNNER_TEMP/weather-dependency-audit.json\"",
          "timeout-minutes": 15
        },
        {
          "if": "${{ !inputs.development_only }}",
          "name": "Train only on frozen training then export selected validation candidate",
          "run": "timeout --signal=TERM --kill-after=20s 7700 \"$RUNNER_TEMP/weather-venv/bin/python\" verification/owners/weather_forecast_verify/remote.py --root \"$RUNNER_TEMP/weather-result\"",
          "timeout-minutes": 130
        },
        {
          "env": {
            "WEATHER_DEVELOPMENT_ONLY": "true"
          },
          "if": "${{ inputs.development_only }}",
          "name": "Separate development-only cold-source experiment",
          "run": "timeout --signal=TERM --kill-after=20s 7700 \"$RUNNER_TEMP/weather-venv/bin/python\" verification/owners/weather_forecast_verify/development/train.py --root \"$RUNNER_TEMP/weather-result\"",
          "timeout-minutes": 130
        },
        {
          "if": "always()",
          "name": "Retain licensed failed or successful checkpoint",
          "uses": "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02",
          "with": {
            "if-no-files-found": "warn",
            "name": "weather-frozen-candidate",
            "path": "${{ runner.temp }}/weather-result/adapter/*\n${{ runner.temp }}/weather-result/initial/*\n${{ runner.temp }}/weather-result/*.json\n${{ runner.temp }}/weather-result/*.safetensors",
            "retention-days": 7
          }
        }
      ],
      "timeout-minutes": 160
    }
  },
  "name": "Weather archive evaluator experiment",
  "on": {
    "workflow_dispatch": {
      "inputs": {
        "development_only": {
          "default": false,
          "required": false,
          "type": "boolean"
        },
        "forward_port": {
          "default": "",
          "required": false,
          "type": "string"
        },
        "mode": {
          "default": "experiment",
          "options": [
            "experiment",
            "serve"
          ],
          "required": true,
          "type": "choice"
        },
        "package_url": {
          "default": "",
          "required": false,
          "type": "string"
        },
        "report_sha256": {
          "default": "",
          "required": false,
          "type": "string"
        },
        "report_url": {
          "default": "",
          "required": false,
          "type": "string"
        },
        "runnable_url": {
          "default": "",
          "required": false,
          "type": "string"
        },
        "slot": {
          "default": "",
          "required": false,
          "type": "string"
        }
      }
    }
  },
  "permissions": {
    "contents": "read"
  },
  "run-name": "Weather owner ${{ inputs.mode }} cb65961105934a849aceec6d66add0db"
}
