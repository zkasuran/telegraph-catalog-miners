{
  "name": "Bounded AI text origin owner",
  "on": {
    "workflow_dispatch": {
      "inputs": {
        "mode": {
          "type": "choice",
          "options": [
            "verify",
            "serve"
          ],
          "required": true,
          "default": "verify"
        },
        "package_url": {
          "type": "string",
          "required": false,
          "default": ""
        },
        "package_sha256": {
          "type": "string",
          "required": false,
          "default": ""
        },
        "report_url": {
          "type": "string",
          "required": false,
          "default": ""
        },
        "report_sha256": {
          "type": "string",
          "required": false,
          "default": ""
        },
        "forward_port": {
          "type": "string",
          "required": false,
          "default": ""
        },
        "slot": {
          "type": "string",
          "required": false,
          "default": ""
        },
        "runnable_url": {
          "type": "string",
          "required": false,
          "default": ""
        }
      }
    }
  },
  "permissions": {
    "contents": "read"
  },
  "concurrency": {
    "group": "ai-text-owner-${{ inputs.mode }}",
    "cancel-in-progress": false
  },
  "jobs": {
    "verify": {
      "if": "${{ inputs.mode == 'verify' }}",
      "runs-on": "ubuntu-24.04",
      "timeout-minutes": 350,
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "TOKENIZERS_PARALLELISM": "false",
        "OMP_NUM_THREADS": "4",
        "MKL_NUM_THREADS": "4"
      },
      "steps": [
        {
          "uses": "actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803",
          "with": {
            "persist-credentials": false,
            "sparse-checkout-cone-mode": false,
            "sparse-checkout": "/verification/owners/ai_text_detection/\n/.github/workflows/evaluator-owner-ai_text_detection.yml"
          }
        },
        {
          "name": "Packaged source-only release gate",
          "run": "bash verification/owners/ai_text_detection/verify.sh"
        },
        {
          "uses": "actions/setup-go@924ae3a1cded613372ab5595356fb5720e22ba16",
          "with": {
            "go-version": "1.25.7",
            "cache": false
          }
        },
        {
          "name": "Prepare private runner output",
          "run": "mkdir -p \"$RUNNER_TEMP/ai-owner\""
        },
        {
          "name": "Hash-locked CPU dependencies and actual advisory audit",
          "timeout-minutes": 15,
          "run": "python3 -m venv \"$RUNNER_TEMP/ai-owner-venv\"\n\"$RUNNER_TEMP/ai-owner-venv/bin/python\" -m pip install --require-hashes --only-binary=:all: --index-url https://pypi.org/simple --extra-index-url https://download.pytorch.org/whl/cpu -r verification/owners/ai_text_detection/requirements.lock\n\"$RUNNER_TEMP/ai-owner-venv/bin/python\" -m pip check\n\"$RUNNER_TEMP/ai-owner-venv/bin/python\" verification/owners/ai_text_detection/dependency_audit.py --lock verification/owners/ai_text_detection/requirements.lock --out \"$RUNNER_TEMP/audit-requirements.txt\" --report \"$RUNNER_TEMP/ai-owner/dependency-audit.json\""
        },
        {
          "name": "Restore exact licensed development input and source roles",
          "timeout-minutes": 20,
          "run": "timeout --signal=TERM --kill-after=20s 1160s \"$RUNNER_TEMP/ai-owner-venv/bin/python\" verification/owners/ai_text_detection/generate.py --root \"$RUNNER_TEMP/ai-owner\" --partition development"
        },
        {
          "name": "Restore verified actual train-only source-window generation",
          "timeout-minutes": 20,
          "run": "timeout --signal=TERM --kill-after=20s 1160s \"$RUNNER_TEMP/ai-owner-venv/bin/python\" verification/owners/ai_text_detection/augment_training.py --root \"$RUNNER_TEMP/ai-owner\""
        },
        {
          "name": "Restore exact actual third-context training input and producer",
          "timeout-minutes": 20,
          "run": "timeout --signal=TERM --kill-after=20s 1160s \"$RUNNER_TEMP/ai-owner-venv/bin/python\" verification/owners/ai_text_detection/augment_training.py --root \"$RUNNER_TEMP/ai-owner\" --additional"
        },
        {
          "name": "Restore actual independent training-origin supplement and producer",
          "timeout-minutes": 20,
          "run": "timeout --signal=TERM --kill-after=20s 1160s \"$RUNNER_TEMP/ai-owner-venv/bin/python\" verification/owners/ai_text_detection/generate_supplement.py --root \"$RUNNER_TEMP/ai-owner\""
        },
        {
          "name": "Restore exact completed secondary origins and original producer",
          "timeout-minutes": 20,
          "run": "timeout --signal=TERM --kill-after=20s 1160s \"$RUNNER_TEMP/ai-owner-venv/bin/python\" verification/owners/ai_text_detection/generate_secondary.py --root \"$RUNNER_TEMP/ai-owner\""
        },
        {
          "name": "Fit same-verdict source contrast under unchanged all-format gates",
          "timeout-minutes": 145,
          "run": "timeout --signal=TERM --kill-after=20s 8660s \"$RUNNER_TEMP/ai-owner-venv/bin/python\" verification/owners/ai_text_detection/run.py --root \"$RUNNER_TEMP/ai-owner\""
        },
        {
          "name": "Separate held-out checkpoint audit generation",
          "timeout-minutes": 20,
          "run": "timeout --signal=TERM --kill-after=20s 1160s \"$RUNNER_TEMP/ai-owner-venv/bin/python\" verification/owners/ai_text_detection/generate.py --root \"$RUNNER_TEMP/ai-owner\" --partition audit"
        },
        {
          "name": "Actual reference-engine frozen audit and failure controls",
          "timeout-minutes": 120,
          "run": "timeout --signal=TERM --kill-after=20s 7160s \"$RUNNER_TEMP/ai-owner-venv/bin/python\" verification/owners/ai_text_detection/audit_runtime.py --root \"$RUNNER_TEMP/ai-owner\""
        },
        {
          "name": "Preserve bounded licensed pass or failure evidence",
          "if": "${{ always() }}",
          "timeout-minutes": 3,
          "run": "python3 verification/owners/ai_text_detection/preserve.py --root \"$RUNNER_TEMP/ai-owner\""
        },
        {
          "uses": "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02",
          "if": "${{ always() }}",
          "with": {
            "name": "ai-text-owner-result",
            "retention-days": 7,
            "if-no-files-found": "error",
            "path": "${{ runner.temp }}/ai-owner/public-result/"
          }
        }
      ]
    },
    "serve": {
      "if": "${{ inputs.mode == 'serve' }}",
      "runs-on": "ubuntu-24.04",
      "timeout-minutes": 350,
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "TOKENIZERS_PARALLELISM": "false",
        "OMP_NUM_THREADS": "4",
        "MKL_NUM_THREADS": "4",
        "PACKAGE_URL": "${{ inputs.package_url }}",
        "PACKAGE_SHA256": "${{ inputs.package_sha256 }}",
        "REPORT_URL": "${{ inputs.report_url }}",
        "REPORT_SHA256": "${{ inputs.report_sha256 }}",
        "FORWARD_PORT": "${{ inputs.forward_port }}",
        "SLOT": "${{ inputs.slot }}",
        "RUNNABLE_URL": "${{ inputs.runnable_url }}"
      },
      "steps": [
        {
          "uses": "actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803",
          "with": {
            "persist-credentials": false,
            "sparse-checkout-cone-mode": false,
            "sparse-checkout": "/verification/owners/ai_text_detection/\n/.github/workflows/evaluator-owner-ai_text_detection.yml"
          }
        },
        {
          "name": "Same source-only gate before serving",
          "run": "bash verification/owners/ai_text_detection/verify.sh"
        },
        {
          "uses": "actions/setup-go@924ae3a1cded613372ab5595356fb5720e22ba16",
          "with": {
            "go-version": "1.25.7",
            "cache": false
          }
        },
        {
          "name": "Prepare runner output",
          "run": "mkdir -p \"$RUNNER_TEMP/ai-owner\""
        },
        {
          "name": "Hash-locked CPU dependencies and actual advisory audit",
          "timeout-minutes": 15,
          "run": "python3 -m venv \"$RUNNER_TEMP/ai-owner-venv\"\n\"$RUNNER_TEMP/ai-owner-venv/bin/python\" -m pip install --require-hashes --only-binary=:all: --index-url https://pypi.org/simple --extra-index-url https://download.pytorch.org/whl/cpu -r verification/owners/ai_text_detection/requirements.lock\n\"$RUNNER_TEMP/ai-owner-venv/bin/python\" -m pip check\n\"$RUNNER_TEMP/ai-owner-venv/bin/python\" verification/owners/ai_text_detection/dependency_audit.py --lock verification/owners/ai_text_detection/requirements.lock --out \"$RUNNER_TEMP/audit-requirements.txt\" --report \"$RUNNER_TEMP/ai-owner/dependency-audit.json\""
        },
        {
          "name": "Start exact bounded public serving lease",
          "timeout-minutes": 20,
          "run": "\"$RUNNER_TEMP/ai-owner-venv/bin/python\" verification/owners/ai_text_detection/serve.py --root \"$RUNNER_TEMP/ai-owner\" --package-url \"$PACKAGE_URL\" --package-sha256 \"$PACKAGE_SHA256\" --report-url \"$REPORT_URL\" --report-sha256 \"$REPORT_SHA256\" --forward-port \"$FORWARD_PORT\" --slot \"$SLOT\" --runnable-url \"$RUNNABLE_URL\" > \"$RUNNER_TEMP/ai-owner/serve.log\" 2>&1 &\npid=$!\nprintf \"%s\\n\" \"$pid\" > \"$RUNNER_TEMP/ai-owner/serve.pid\"\nfor attempt in $(seq 1 1100); do\n  test -f \"$RUNNER_TEMP/ai-owner/lease.json\" && exit 0\n  kill -0 \"$pid\" || exit 1\n  sleep 1\ndone\nexit 1"
        },
        {
          "uses": "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02",
          "with": {
            "name": "ai-text-owner-public-lease",
            "retention-days": 1,
            "if-no-files-found": "error",
            "path": "${{ runner.temp }}/ai-owner/lease.json"
          }
        },
        {
          "name": "Keep same package serving within five-hour lease",
          "timeout-minutes": 300,
          "run": "pid=$(cat \"$RUNNER_TEMP/ai-owner/serve.pid\")\nwhile kill -0 \"$pid\" 2>/dev/null; do sleep 20; done"
        }
      ]
    }
  }
}
